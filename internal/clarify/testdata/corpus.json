    },
    {
      "name": "en open with question",
      "content": "x [CLARIFY: which format?] y",
      "spans": [{ "raw": "[CLARIFY: which format?]", "offset": 2, "resolved": false }]
    },
    {
      "name": "en open with options",
      "content": "[CLARIFY: where to persist? | in-place | sidecar]",
      "spans": [{ "raw": "[CLARIFY: where to persist? | in-place | sidecar]", "offset": 0, "resolved": false }]
    },
    {
      "name": "en bare",
      "content": "something unclear [CLARIFY] here",
      "spans": [{ "raw": "[CLARIFY]", "offset": 18, "resolved": false }]
    },
    {
      "name": "pt resolved",
      "content": "[ESCLARECIDO: onde? → no doc]",
      "spans": [{ "raw": "[ESCLARECIDO: onde? → no doc]", "offset": 0, "resolved": true }]
