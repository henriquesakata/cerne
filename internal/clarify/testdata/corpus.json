      "raw": "[CLARIFY: same?]",
      "offset": 3,
      "answer": "no",
      "want": null
    },
    {
      "name": "resolved marker refuses",
      "content": "[CLARIFIED: where? → in the doc]",
      "raw": "[CLARIFIED: where? → in the doc]",
      "offset": 0,
      "answer": "again",
      "want": null
