      "offset": 0,
      "answer": "in-place",
      "want": "[CLARIFIED: where? → in-place]"
    },
    {
      "name": "only the anchored duplicate is rewritten",
      "content": "[CLARIFY: same?] mid [CLARIFY: same?]",
