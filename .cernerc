project_id = "cerne"
backend = "git@gitlab.com:rockt/cerne-docs.git"
default_scope = ""
pin_branch = "main"
# F-0198: only the serialized main-branch CI job writes the committed pin.
# Local clients always use the gitignored .docs/.snapshot sidecar.
pin_writer = "ci"
# F-0178: pull also reconciles golden paths (marked notes/runbooks) into
# .claude/skills/learned-* — whoever pulls docs also gets the learned skills.
sync_skills = true
# F-0117: every push incrementally recompiles the dirty wiki pages via [llm].
compile_on_push = true

# F-0353: this CLI prints English (F-0124), so the lint warns when a spec
# criterion quotes a pt-BR CLI message (spec-cli-literal-pt).
[lint]
cli_output_language = "en"

# F-0179: a bare SHA in `feature complete --commit` / `feature deliver` resolves
# to a clickable URL through this template ({sha} is required).
[delivery]
commit_url = "https://github.com/henriquesakata/cerne/commit/{sha}"
# F-0355: the forge that hosts the repo above; `feature complete --commit` finds
# the PR holding the commit and `feature accept` checks it reached the default
# branch. `--mr #<n>` resolves through pr_url.
forge = "github"
pr_url = "https://github.com/henriquesakata/cerne/pull/{n}"

# Code→doc drift (F-0113/F-0116): this project has no modules, so the axis
# is component (the features' tags). Coverage grows with `cerne feature retag`
# on the backlog; a component with no matching feature is harmless.
[component_paths]
drift = ["internal/lint/drift.go", "internal/cli/drift.go", "internal/app/autodrift.go", "internal/app/draft.go", "internal/app/projecthead.go", "internal/gitback/changedpaths.go", "internal/project/projecthead.go"]
lint = ["internal/lint/**"]
llm = ["internal/llm/**"]
compile = ["internal/compile/**", "internal/cli/compilecmd.go"]
wiki = ["internal/wiki/**"]
gitback = ["internal/gitback/**"]

# LLM callable through the Claude Code subscription (no API key): enables
# single-phase `cerne compile` (no two-phase delegation),
# `cerne drift --auto` (automatic errata, D-0005) and direct `cerne ask`.
[llm]
mode = "claude-cli"
